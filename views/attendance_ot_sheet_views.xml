<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- List View for Attendance OT Approval Sheet -->
    <record id="view_attendance_ot_sheet_tree" model="ir.ui.view">
        <field name="name">attendance.ot.approval.sheet.list</field>
        <field name="model">attendance.ot.approval.sheet</field>
        <field name="arch" type="xml">
            <list string="Attendance OT &amp; Absent Approval Sheets" sample="1">
                <header>
                    <button name="action_generate_subordinate_sheets" string="Generate / Refresh Subordinate Sheets" type="object" class="btn-primary" display="always"/>
                </header>
                <field name="name" decoration-bf="1"/>
                <field name="employee_id"/>
                <field name="department_id" optional="show"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="period_type" widget="badge"/>
                <field name="total_raw_ot_hours" widget="float" string="Raw OT (hrs)"/>
                <field name="total_ot_day_hours" widget="float" string="Day (1.5x)"/>
                <field name="total_ot_night_hours" widget="float" string="Night (1.75x)"/>
                <field name="total_ot_weekend_hours" widget="float" string="Weekend (2.0x)"/>
                <field name="total_ot_holiday_hours" widget="float" string="Holiday (2.5x)"/>
                <field name="total_approved_ot_hours" widget="float" decoration-success="total_approved_ot_hours &gt; 0" string="Total Approved OT"/>
                <field name="total_approved_late_hours" widget="float" decoration-danger="total_approved_late_hours &gt; 0" string="Unapproved Late"/>
                <field name="state" widget="badge" decoration-info="state == 'draft'" decoration-warning="state == 'submitted'" decoration-success="state == 'approved'" decoration-danger="state == 'rejected'"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <!-- Form View for Attendance OT Approval Sheet -->
    <record id="view_attendance_ot_sheet_form" model="ir.ui.view">
        <field name="name">attendance.ot.approval.sheet.form</field>
        <field name="model">attendance.ot.approval.sheet</field>
        <field name="arch" type="xml">
            <form string="Attendance OT &amp; Absent Approval Sheet">
                <header>
                    <button name="action_fetch_attendance_records" string="Fetch / Refresh Records" type="object" class="oe_highlight" invisible="state not in ('draft', 'submitted')"/>
                    <button name="action_submit" string="Submit for Approval" type="object" class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_approve" string="Approve Report &amp; Sync Contract" type="object" class="btn-success" invisible="state not in ('draft', 'submitted') or not can_approve"/>
                    <button name="action_reject" string="Reject Report" type="object" class="btn-danger" invisible="state != 'submitted' or not can_approve"/>
                    <button name="action_excuse_all_late" string="Excuse All Late Arrivals" type="object" class="btn-outline-info" invisible="state not in ('draft', 'submitted') or not can_approve"/>
                    <button name="action_accept_all_ot" string="Accept All OT" type="object" class="btn-outline-primary" invisible="state not in ('draft', 'submitted') or not can_approve"/>
                    <button name="action_reopen" string="Reopen for Adjustment" type="object" class="btn-warning" invisible="state not in ('approved', 'rejected') or not can_approve"/>
                    <button name="action_reset_draft" string="Reset to Draft" type="object" invisible="state == 'draft' or not can_approve"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,approved,rejected"/>
                </header>
                <sheet>
                    <field name="can_approve" invisible="1"/>
                    <div class="oe_title">
                        <label for="name" string="Report Reference"/>
                        <h1>
                            <field name="name" placeholder="ATT-OT-2026-09-EMP001"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Employee &amp; Period Details">
                            <field name="employee_id" options="{'no_create': True}" readonly="state != 'draft'"/>
                            <field name="department_id"/>
                            <field name="job_id"/>
                            <field name="manager_id"/>
                            <field name="contract_id"/>
                        </group>
                        <group string="Coverage Period">
                            <field name="period_type" readonly="state in ('approved', 'rejected')"/>
                            <field name="date_from" readonly="state in ('approved', 'rejected')"/>
                            <field name="date_to" readonly="state in ('approved', 'rejected')"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>

                    <!-- Overtime & Late Hours Summary Cards -->
                    <div class="row g-2 text-center mb-3">
                        <!-- Overtime Cards -->
                        <div class="col-6 col-md-3">
                            <div class="border rounded p-2 bg-light shadow-sm">
                                <span class="text-muted d-block small fw-bold">Day OT (1.5x)</span>
                                <span class="fs-5 fw-bold text-primary">
                                    <field name="total_ot_day_hours" widget="float"/> hrs
                                </span>
                            </div>
                        </div>
                        <div class="col-6 col-md-3">
                            <div class="border rounded p-2 bg-light shadow-sm">
                                <span class="text-muted d-block small fw-bold">Night OT (1.75x)</span>
                                <span class="fs-5 fw-bold text-info">
                                    <field name="total_ot_night_hours" widget="float"/> hrs
                                </span>
                            </div>
                        </div>
                        <div class="col-6 col-md-3">
                            <div class="border rounded p-2 bg-light shadow-sm">
                                <span class="text-muted d-block small fw-bold">Weekend OT (2.0x)</span>
                                <span class="fs-5 fw-bold text-dark">
                                    <field name="total_ot_weekend_hours" widget="float"/> hrs
                                </span>
                            </div>
                        </div>
                        <div class="col-6 col-md-3">
                            <div class="border rounded p-2 bg-light shadow-sm">
                                <span class="text-muted d-block small fw-bold">Holiday OT (2.5x)</span>
                                <span class="fs-5 fw-bold text-danger">
                                    <field name="total_ot_holiday_hours" widget="float"/> hrs
                                </span>
                            </div>
                        </div>

                        <!-- Second Row: Totals, Late Minutes, and Deductions -->
                        <div class="col-6 col-md-3">
                            <div class="border border-success rounded p-2 bg-light shadow-sm">
                                <span class="text-success d-block small fw-bold">Total Approved OT</span>
                                <span class="fs-4 fw-bold text-success">
                                    <field name="total_approved_ot_hours" widget="float"/> hrs
                                </span>
                            </div>
                        </div>
                        <div class="col-6 col-md-3">
                            <div class="border rounded p-2 bg-light shadow-sm">
                                <span class="text-muted d-block small fw-bold">Recorded Late Mins</span>
                                <span class="fs-5 fw-bold text-warning">
                                    <field name="total_raw_late_minutes"/> mins
                                </span>
                            </div>
                        </div>
                        <div class="col-6 col-md-3">
                            <div class="border border-info rounded p-2 bg-light shadow-sm">
                                <span class="text-info d-block small fw-bold">Excused Late Mins</span>
                                <span class="fs-5 fw-bold text-info">
                                    <field name="total_excused_late_minutes"/> mins
                                </span>
                            </div>
                        </div>
                        <div class="col-6 col-md-3">
                            <div class="border border-danger rounded p-2 bg-light shadow-sm">
                                <span class="text-danger d-block small fw-bold">Total Deduction Hours</span>
                                <span class="fs-4 fw-bold text-danger">
                                    <field name="total_approved_late_hours" widget="float"/> hrs
                                </span>
                            </div>
                        </div>
                    </div>

                    <notebook>
                        <page string="Daily Attendance Breakdowns" name="daily_lines">
                            <field name="line_ids">
                                <list string="Daily Attendance Lines" editable="bottom">
                                    <field name="date"/>
                                    <field name="day_name" optional="hide"/>
                                    <field name="status" widget="badge" decoration-success="status == 'present'" decoration-danger="status == 'absent'" decoration-warning="status == 'missed_punch'" decoration-info="status == 'on_leave'"/>
                                    <field name="leave_type_id" string="Time Off" optional="hide"/>
                                    <field name="first_checkin" widget="datetime" optional="show"/>
                                    <field name="last_checkout" widget="datetime" optional="show"/>
                                    <field name="worked_hours" widget="float" optional="show"/>
                                    
                                    <!-- Overtime Review -->
                                    <field name="raw_ot_hours" widget="float" string="Raw OT"/>
                                    <field name="is_ot_acceptable" widget="boolean_toggle" string="Accept OT?"/>
                                    <field name="ot_category" string="OT Factor"/>
                                    <field name="approved_ot_hours" widget="float" string="Approved OT" decoration-success="approved_ot_hours &gt; 0"/>
                                    <field name="approved_ot_day_hours" widget="float" string="Day (1.5)" optional="hide"/>
                                    <field name="approved_ot_night_hours" widget="float" string="Night (1.75)" optional="hide"/>
                                    <field name="approved_ot_weekend_hours" widget="float" string="Weekend (2.0)" optional="hide"/>
                                    <field name="approved_ot_holiday_hours" widget="float" string="Holiday (2.5)" optional="hide"/>

                                    <!-- Late Minutes & Excuse Review -->
                                    <field name="raw_late_minutes" string="Late (mins)" decoration-danger="raw_late_minutes &gt; 0 and not is_late_excused" decoration-muted="is_late_excused"/>
                                    <field name="is_late_excused" widget="boolean_toggle" string="Excuse Late?"/>
                                    <field name="late_excuse_reason" string="Late Excuse Reason" optional="show"/>
                                    <field name="deduction_late_minutes" string="Deduct (mins)" optional="hide"/>
                                    <field name="is_absent_excused" widget="boolean_toggle" string="Excuse Absent?" optional="show"/>
                                    <field name="approved_late_hours" widget="float" string="Deduction (hrs)" decoration-danger="approved_late_hours &gt; 0"/>
                                    <field name="notes" placeholder="Manager comments..."/>
                                </list>
                            </field>
                        </page>
                        <page string="Approval Audit &amp; Rejection Reason" name="audit">
                            <group>
                                <group string="Approval Details">
                                    <field name="approved_by_id"/>
                                    <field name="approval_date"/>
                                </group>
                                <group string="Rejection Info">
                                    <field name="rejection_reason" placeholder="State reason if report was rejected..."/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_attendance_ot_sheet_search" model="ir.ui.view">
        <field name="name">attendance.ot.approval.sheet.search</field>
        <field name="model">attendance.ot.approval.sheet</field>
        <field name="arch" type="xml">
            <search string="Search Attendance OT Sheets">
                <field name="name"/>
                <field name="employee_id"/>
                <field name="department_id"/>
                <field name="manager_id"/>
                <filter string="To Approve" name="to_approve" domain="[('state', '=', 'submitted'), ('employee_id.user_id', '!=', uid)]"/>
                <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Approved" name="approved" domain="[('state', '=', 'approved')]"/>
                <filter string="Rejected" name="rejected" domain="[('state', '=', 'rejected')]"/>
                <separator/>
                <filter string="My Subordinates" name="my_subordinates" domain="['|', ('manager_id.user_id', '=', uid), ('employee_id.parent_id.user_id', '=', uid)]"/>
                <filter string="My Sheets" name="my_sheets" domain="[('employee_id.user_id', '=', uid)]"/>
                <group expand="0" string="Group By">
                    <filter string="Employee" name="group_employee" context="{'group_by': 'employee_id'}"/>
                    <filter string="Department" name="group_department" context="{'group_by': 'department_id'}"/>
                    <filter string="Manager" name="group_manager" context="{'group_by': 'manager_id'}"/>
                    <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Period Type" name="group_period_type" context="{'group_by': 'period_type'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_attendance_ot_sheet" model="ir.actions.act_window">
        <field name="name">Attendance OT &amp; Absent Approval Sheets</field>
        <field name="res_model">attendance.ot.approval.sheet</field>
        <field name="view_mode">list,form,kanban</field>
        <field name="search_view_id" ref="view_attendance_ot_sheet_search"/>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create or generate the first Attendance OT &amp; Absent Approval Sheet!
            </p>
            <p>
                Aggregate daily biometric attendance records, review raw overtime and late hours, adjust approved metrics across all 4 overtime categories (1.5x, 1.75x, 2.0x, 2.5x), and sync seamlessly with employee payroll contracts.
            </p>
        </field>
    </record>

    <!-- Backend Menus -->
    <!-- Under ZKTeco -> Approvals -->
    <menuitem id="menu_zkteco_attendance_ot_sheet"
              name="OT &amp; Absent Approvals"
              parent="zkteco_attendance.menu_zkteco_approvals_parent"
              action="action_attendance_ot_sheet"
              sequence="10"
              groups="zkteco_attendance.group_zkteco_manager"/>

    <!-- Under Attendances App Root -->
    <menuitem id="menu_hr_attendance_ot_sheet"
              name="OT &amp; Absent Approvals"
              parent="hr_attendance.menu_hr_attendance_root"
              action="action_attendance_ot_sheet"
              sequence="30"
              groups="zkteco_attendance.group_zkteco_manager,hr.group_hr_user"/>
</odoo>
