<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Auto-generate & Submit Monthly Attendance OT & Absent Sheets directly to Managers -->
        <record id="ir_cron_generate_monthly_attendance_ot_sheets" model="ir.cron">
            <field name="name">Attendance OT: Auto-Generate &amp; Submit Monthly Sheets to Managers</field>
            <field name="model_id" ref="model_attendance_ot_approval_sheet"/>
            <field name="state">code</field>
            <field name="code">model.generate_monthly_sheets()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active">True</field>
        </record>
    </data>
</odoo>
