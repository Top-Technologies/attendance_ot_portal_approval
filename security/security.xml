<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Module Category -->
        <record id="module_category_attendance_ot" model="ir.module.category">
            <field name="name">Attendance OT &amp; Absent Approvals</field>
            <field name="description">Manage Attendance Overtime and Absent/Late Hour Approvals and Portal Exposure</field>
            <field name="sequence">25</field>
        </record>

        <!-- Security Groups -->
        <record id="group_attendance_ot_user" model="res.groups">
            <field name="name">Officer</field>
            <field name="category_id" ref="module_category_attendance_ot"/>
            <field name="implied_ids" eval="[(4, ref('hr.group_hr_user'))]"/>
        </record>

        <record id="group_attendance_ot_manager" model="res.groups">
            <field name="name">Administrator</field>
            <field name="category_id" ref="module_category_attendance_ot"/>
            <field name="implied_ids" eval="[(4, ref('group_attendance_ot_user'))]"/>
        </record>
    </data>

    <data noupdate="0">
        <!-- Multi-Company Rule -->
        <record id="attendance_ot_sheet_comp_rule" model="ir.rule">
            <field name="name">Attendance OT Sheet Multi-Company</field>
            <field name="model_id" ref="model_attendance_ot_approval_sheet"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>

        <!-- Employee Rule: View own sheets -->
        <record id="attendance_ot_sheet_employee_rule" model="ir.rule">
            <field name="name">Attendance OT Sheet: View Own Sheets</field>
            <field name="model_id" ref="model_attendance_ot_approval_sheet"/>
            <field name="domain_force">[('employee_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <!-- Subordinate Manager Rule: View and manage subordinate sheets -->
        <record id="attendance_ot_sheet_subordinate_manager_rule" model="ir.rule">
            <field name="name">Attendance OT Sheet: Subordinate Manager Rule</field>
            <field name="model_id" ref="model_attendance_ot_approval_sheet"/>
            <field name="domain_force">[
                '|', '|', '|',
                ('employee_id.user_id', '=', user.id),
                ('employee_id.parent_id.user_id', '=', user.id),
                ('employee_id.leave_manager_id', '=', user.id),
                ('manager_id.user_id', '=', user.id)
            ]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <!-- Officer / Admin Rule: View all sheets -->
        <record id="attendance_ot_sheet_officer_rule" model="ir.rule">
            <field name="name">Attendance OT Sheet: Officer View All</field>
            <field name="model_id" ref="model_attendance_ot_approval_sheet"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_attendance_ot_user'))]"/>
        </record>

        <!-- Portal User Rule: View own sheets and subordinate sheets -->
        <record id="attendance_ot_sheet_portal_rule" model="ir.rule">
            <field name="name">Attendance OT Sheet: Portal User Rule</field>
            <field name="model_id" ref="model_attendance_ot_approval_sheet"/>
            <field name="domain_force">[
                '|', '|', '|',
                ('employee_id.user_id', '=', user.id),
                ('employee_id.parent_id.user_id', '=', user.id),
                ('employee_id.leave_manager_id', '=', user.id),
                ('manager_id.user_id', '=', user.id)
            ]</field>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        </record>

        <!-- Portal User Rule for Line -->
        <record id="attendance_ot_line_portal_rule" model="ir.rule">
            <field name="name">Attendance OT Line: Portal User Rule</field>
            <field name="model_id" ref="model_attendance_ot_approval_line"/>
            <field name="domain_force">[
                '|', '|', '|',
                ('sheet_id.employee_id.user_id', '=', user.id),
                ('sheet_id.employee_id.parent_id.user_id', '=', user.id),
                ('sheet_id.employee_id.leave_manager_id', '=', user.id),
                ('sheet_id.manager_id.user_id', '=', user.id)
            ]</field>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        </record>
    </data>
</odoo>
